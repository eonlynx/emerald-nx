+// The dock's UP: the field party menu's cursor on CANCEL, its last entry.
+void CtrParty_SelectLast(void)
+{
+    s8 *slotPtr;
+    s8 old, last = PARTY_SIZE + 1;
+
+    if (sPartyMenuInternal == NULL || gPartyMenu.menuType != PARTY_MENU_TYPE_FIELD
+     || sPartyMenuInternal->chooseHalf)
+        return;
+    slotPtr = GetCurrentPartySlotPtr();
+    old = *slotPtr;
+    if (old == last)
+        return;
+    *slotPtr = last;
+    AnimatePartySlot(old, 0);
+    AnimatePartySlot(last, 1);
+    PlaySE(SE_SELECT);
+}
+
