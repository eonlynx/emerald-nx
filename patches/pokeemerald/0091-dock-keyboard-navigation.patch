+// The dock's UP: the list's cursor on its last species, as the START menu's
+// LIST BOTTOM does it, without opening the menu.
+void CtrPokedex_SelectLast(void)
+{
+    if (!CtrPokedex_IsOpen() || sPokedexView == NULL)
+        return;
+    if (sPokedexView->currentPage != PAGE_MAIN && sPokedexView->currentPage != PAGE_SEARCH_RESULTS)
+        return;
+    if (sPokedexView->menuIsOpen || sPokedexView->pokemonListCount == 0)
+        return;
+    if (sPokedexView->selectedPokemon == sPokedexView->pokemonListCount - 1)
+        return;
+    sPokedexView->selectedPokemon = sPokedexView->pokemonListCount - 1;
+    sPokedexView->pokeBallRotation = sPokedexView->pokemonListCount * 16 + POKEBALL_ROTATION_BOTTOM;
+    ClearMonSprites();
+    CreateMonSpritesAtPos(sPokedexView->selectedPokemon, 0xE);
+    PlaySE(SE_DEX_SCROLL);
+}
+
 // Where the Pokédex is, for the bottom screen to draw it itself. FALSE while
 // there is nothing to read (a page coming in or going out): the bottom
 // screen keeps what it showed.
